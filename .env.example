# Copy to .env and fill in for local development.

DATABASE_URL="file:../data/dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"

# Only set to "true" if served over HTTPS (e.g. behind a reverse proxy). A Secure
# cookie is silently dropped by the browser over plain HTTP, which breaks every login.
COOKIE_SECURE="false"

UPLOAD_DIR="./data/uploads"
